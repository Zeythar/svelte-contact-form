# Example Vite environment variables for the frontend build
# Copy to frontend/.env or set these variables in your deployment pipeline.

# Base URL for the backend API (no trailing slash). Example:
# VITE_API_BASE=https://api.example.com
VITE_API_BASE=http://localhost:8080

# Google reCAPTCHA v3 site key for the frontend. Leave empty to disable
# reCAPTCHA in development builds.
# VITE_RECAPTCHA_SITE_KEY=your_site_key_here
VITE_RECAPTCHA_SITE_KEY=

# Notes:
# - Vite env vars prefixed with VITE_ are inlined at build time and available
#   via `import.meta.env.VITE_*` in your code.
# - When deploying, set these variables in your CI/CD or hosting environment
#   rather than committing secrets to source control.
